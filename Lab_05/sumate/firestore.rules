// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all by default
    match /{document=**} { allow read, write: if false; }

    // usuarios collection
    match /usuarios/{uid} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.correo == request.auth.token.email;
      allow update: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.correo == resource.data.correo;
      // No delete
    }

    // eventos collection
    match /eventos/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid in request.resource.data.administradores;
      // No delete
    }

    // ediciones collection
    match /ediciones/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.auth.uid in request.resource.data.organizadores &&
                    request.resource.data.estado == 'abierta' &&
                    request.resource.data.voluntarios.ocupados == 0 &&
                    request.resource.data.asistentes.ocupados == 0 &&
                    request.auth.uid in getAfter(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId)).data.administradores;
      allow update: if request.auth != null &&
                    request.auth.uid in resource.data.organizadores &&
                    request.resource.data.eventoId == resource.data.eventoId;
      // No delete
    }
  }
}
