// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Denegar todo por defecto
    match /{document=**} { allow read, write: if false; }

    // ── usuarios ────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.correo == request.auth.token.email;
      allow update: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.correo == resource.data.correo;
      // No delete
    }

    // ── eventos ─────────────────────────────────────────────────────────
    // Cualquier autenticado puede leer eventos.
    // Solo administradores del documento actual pueden editar.
    // Solo quien se incluya como administrador puede crear.
    match /eventos/{id} {
      allow read: if request.auth != null;
      // create: el creador debe estar en la lista de admins del nuevo doc
      allow create: if request.auth != null &&
                    request.auth.uid in request.resource.data.administradores;
      // update: el editor debe ser admin del documento ACTUAL (resource)
      allow update: if request.auth != null &&
                    request.auth.uid in resource.data.administradores;
      // No delete
    }

    // ── ediciones ───────────────────────────────────────────────────────
    match /ediciones/{id} {
      allow read: if request.auth != null;

      // Crear: organizador del nuevo doc + estado inicial + contadores en 0
      // + debe ser admin del evento padre
      allow create: if request.auth != null &&
                    request.auth.uid in request.resource.data.organizadores &&
                    request.resource.data.estado == 'abierta' &&
                    request.resource.data.voluntarios.ocupados == 0 &&
                    request.resource.data.asistentes.ocupados == 0 &&
                    request.auth.uid in getAfter(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId)).data.administradores;

      // Update por organizador: puede cambiar cualquier campo excepto eventoId
      allow update: if request.auth != null &&
                    request.auth.uid in resource.data.organizadores &&
                    request.resource.data.eventoId == resource.data.eventoId;

      // Update por postulante asistente: solo puede incrementar en 1
      // el contador de asistentes.ocupados, si hay cupo y la convocatoria
      // está abierta. El existsAfter verifica que se cree su postulación
      // en la misma transacción.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asistentes'])
                    && request.resource.data.asistentes.diff(resource.data.asistentes).affectedKeys().hasOnly(['ocupados'])
                    && request.resource.data.asistentes.ocupados == resource.data.asistentes.ocupados + 1
                    && request.resource.data.asistentes.ocupados <= resource.data.asistentes.cupos
                    && resource.data.estado == 'abierta'
                    && resource.data.asistentes.abierta == true
                    && existsAfter(/databases/$(database)/documents/postulaciones/$(id + '_' + request.auth.uid + '_asistente'));

      // No delete
    }

    // ── postulaciones ───────────────────────────────────────────────────
    match /postulaciones/{pid} {
      // Lectura: el dueño de la postulación O un organizador de la edición;
      // si no existe aún, se permite leer (devuelve vacío) para que la transacción compruebe duplicados.
      allow read: if request.auth != null &&
                  (resource == null ||
                   resource.data.usuarioId == request.auth.uid ||
                   request.auth.uid in get(/databases/$(database)/documents/ediciones/$(resource.data.edicionId)).data.organizadores);

      // Crear: el usuario se postula a sí mismo con id determinista
      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid
                    && pid == request.resource.data.edicionId + '_' + request.auth.uid + '_' + request.resource.data.rol
                    && request.resource.data.rol in ['voluntario', 'asistente']
                    && request.resource.data.asistio == false
                    && request.resource.data.estado == (request.resource.data.rol == 'asistente' ? 'aceptada' : 'enviada')
                    && get(/databases/$(database)/documents/ediciones/$(request.resource.data.edicionId)).data.estado == 'abierta';

      // Actualizar: solo organizadores de la edición, y solo estado/asistio.
      // Si se marca asistio=true, la postulación debe estar aceptada
      // y la fecha actual >= fechaInicio de la postulación.
      allow update: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/ediciones/$(resource.data.edicionId)).data.organizadores
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'asistio'])
                    && (request.resource.data.asistio == false ||
                        (request.resource.data.estado == 'aceptada' &&
                         request.time >= resource.data.fechaInicio));

      // No delete
      allow delete: if false;
    }
  }
}
