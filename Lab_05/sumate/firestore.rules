// firestore.rules
//
// Reglas de seguridad de Cloud Firestore para Súmate.
//
// Política general de seguridad:
// - Denegar todo acceso por defecto (match /{document=**} { allow read, write: if false; }).
// - RNF04 (Seguridad): Cada usuario edita únicamente su propia información.
//   Solo los administradores de un evento y los organizadores de una edición
//   pueden modificarlos y ver la lista completa de sus postulantes.
// - RNF07 (Privacidad): La colección 'usuarios' es estrictamente privada; cada usuario
//   solo puede leer y actualizar su propio documento. Los organizadores de una edición
//   únicamente tienen acceso al snapshot del perfil guardado en el documento de postulación.
// - No se permite borrar eventos, ediciones ni perfiles. El dueño sí puede
//   borrar su propia postulación si aún es cancelable (ver reglas de postulaciones).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Denegar todo acceso por defecto
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Funciones auxiliares ──────────────────────────────────────────────
    // Comprueba que la solicitud provenga de un usuario autenticado
    function autenticado() {
      return request.auth != null;
    }

    // Comprueba que el usuario autenticado sea el dueño del recurso
    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // Obtiene los datos de una edición a partir de su id
    function edicionDe(id) {
      return get(/databases/$(database)/documents/ediciones/$(id)).data;
    }

    // ── usuarios ──────────────────────────────────────────────────────────
    // RNF07: Perfil estrictamente privado. Solo el propio usuario puede leer y escribir.
    match /usuarios/{uid} {
      allow get, list: if esDueno(uid);
      allow create: if esDueno(uid) &&
                    request.resource.data.correo == request.auth.token.email;
      allow update: if esDueno(uid) &&
                    request.resource.data.correo == resource.data.correo;
      allow delete: if false;
    }

    // ── eventos ───────────────────────────────────────────────────────────
    // Marca o serie del evento. Lectura pública para cualquier autenticado.
    // Solo sus administradores pueden modificarlo.
    match /eventos/{id} {
      allow read: if autenticado();
      // create: el creador debe incluirse como administrador del evento
      allow create: if autenticado() &&
                    request.auth.uid in request.resource.data.administradores;
      // update: solo un administrador actual (resource) puede actualizar
      allow update: if autenticado() &&
                    request.auth.uid in resource.data.administradores;
      allow delete: if false;
    }

    // ── ediciones ─────────────────────────────────────────────────────────
    // Realización concreta de un evento. Lectura pública para autenticados.
    match /ediciones/{id} {
      allow read: if autenticado();

      // Crear: organizador del nuevo doc + estado inicial 'abierta' + contadores en 0
      // + el creador debe ser administrador del evento padre (evaluado con getAfter)
      allow create: if autenticado() &&
                    request.auth.uid in request.resource.data.organizadores &&
                    request.resource.data.estado == 'abierta' &&
                    request.resource.data.voluntarios.ocupados == 0 &&
                    request.resource.data.asistentes.ocupados == 0 &&
                    request.auth.uid in getAfter(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId)).data.administradores;

      // Update por organizador: puede gestionar su edición manteniendo integridad
      // de contadores, estados válidos y al menos un organizador asignado.
      allow update: if autenticado() &&
                    request.auth.uid in resource.data.organizadores &&
                    request.resource.data.eventoId == resource.data.eventoId &&
                    request.resource.data.estado in ['abierta', 'cerrada', 'finalizada'] &&
                    request.resource.data.voluntarios.ocupados >= 0 &&
                    request.resource.data.voluntarios.ocupados <= request.resource.data.voluntarios.cupos &&
                    request.resource.data.asistentes.ocupados >= 0 &&
                    request.resource.data.asistentes.ocupados <= request.resource.data.asistentes.cupos &&
                    request.resource.data.organizadores.size() >= 1;

      // Update por postulante asistente: solo puede incrementar en 1
      // el contador de asistentes.ocupados si hay cupo y la convocatoria está abierta.
      // existsAfter verifica que se cree su postulación en la misma transacción.
      allow update: if autenticado()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asistentes'])
                    && request.resource.data.asistentes.diff(resource.data.asistentes).affectedKeys().hasOnly(['ocupados'])
                    && request.resource.data.asistentes.ocupados == resource.data.asistentes.ocupados + 1
                    && request.resource.data.asistentes.ocupados <= resource.data.asistentes.cupos
                    && resource.data.estado == 'abierta'
                    && resource.data.asistentes.abierta == true
                    && existsAfter(/databases/$(database)/documents/postulaciones/$(id + '_' + request.auth.uid + '_asistente'));

      // Update por postulante asistente al cancelar: solo -1 a ocupados (>= 0)
      // en la misma transacción en que borra su postulación de asistente.
      // exists comprueba que existía; existsAfter comprueba que ya no existe.
      allow update: if autenticado()
                    && !(request.auth.uid in resource.data.organizadores)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asistentes'])
                    && request.resource.data.asistentes.diff(resource.data.asistentes).affectedKeys().hasOnly(['ocupados'])
                    && request.resource.data.asistentes.ocupados == resource.data.asistentes.ocupados - 1
                    && request.resource.data.asistentes.ocupados >= 0
                    && exists(/databases/$(database)/documents/postulaciones/$(id + '_' + request.auth.uid + '_asistente'))
                    && !existsAfter(/databases/$(database)/documents/postulaciones/$(id + '_' + request.auth.uid + '_asistente'));

      allow delete: if false;
    }

    // ── postulaciones ─────────────────────────────────────────────────────
    match /postulaciones/{pid} {
      // Lectura: el dueño de la postulación O un organizador de la edición;
      // si no existe aún, se permite leer (devuelve vacío) para que la transacción compruebe duplicados.
      allow read: if autenticado() &&
                  (resource == null ||
                   resource.data.usuarioId == request.auth.uid ||
                   request.auth.uid in edicionDe(resource.data.edicionId).organizadores);

      // Crear: el usuario se postula a sí mismo con id determinista.
      // Exige que la edición y la convocatoria del rol estén abiertas.
      allow create: if autenticado()
                    && request.resource.data.usuarioId == request.auth.uid
                    && pid == request.resource.data.edicionId + '_' + request.auth.uid + '_' + request.resource.data.rol
                    && request.resource.data.rol in ['voluntario', 'asistente']
                    && request.resource.data.asistio == false
                    && request.resource.data.estado == (request.resource.data.rol == 'asistente' ? 'aceptada' : 'enviada')
                    && edicionDe(request.resource.data.edicionId).estado == 'abierta'
                    && (
                      (request.resource.data.rol in edicionDe(request.resource.data.edicionId) &&
                       edicionDe(request.resource.data.edicionId)[request.resource.data.rol].abierta == true) ||
                      (request.resource.data.rol + 's' in edicionDe(request.resource.data.edicionId) &&
                       edicionDe(request.resource.data.edicionId)[request.resource.data.rol + 's'].abierta == true)
                    );

      // Actualizar: solo organizadores de la edición, y solo estado o asistio.
      // Si se marca asistio=true, la postulación debe estar aceptada
      // y la fecha actual >= fechaInicio de la postulación.
      allow update: if autenticado()
                    && request.auth.uid in edicionDe(resource.data.edicionId).organizadores
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'asistio'])
                    && (request.resource.data.asistio == false ||
                        (request.resource.data.estado == 'aceptada' &&
                         request.time >= resource.data.fechaInicio));

      // Borrar: solo el dueño, sin asistencia, y según el rol.
      // Voluntario: únicamente en espera. Asistente: solo antes de fechaInicio.
      allow delete: if autenticado()
                    && resource.data.usuarioId == request.auth.uid
                    && resource.data.asistio == false
                    && (
                      (resource.data.rol == 'voluntario' && resource.data.estado == 'enviada')
                      || (resource.data.rol == 'asistente' && request.time < resource.data.fechaInicio)
                    );
    }
  }
}
